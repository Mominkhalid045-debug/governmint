datasource db {
  provider  = "postgresql"
  url       = env("POSTGRES_URL")
  directUrl = env("POSTGRES_URL_NON_POOLING")
}

generator client {
  provider = "prisma-client-js"
}

model User {
  id            String   @id @default(cuid())
  name          String
  email         String   @unique
  password      String?
  role          String   @default("MEMBER")
  avatar        String?
  isActive      Boolean  @default(true)

  committees        CommitteeMember[]
  createdCommittees Committee[]       @relation("CommitteeCreator")
  meetings          Meeting[]         @relation("MeetingCreator")
  votes             Vote[]
  attendances       Attendance[]
  
  // NextAuth relations
  accounts          Account[]
  sessions          Session[]

  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt
}

model Account {
  id                 String  @id @default(cuid())
  userId             String
  type               String
  provider           String
  providerAccountId  String
  refresh_token      String?
  access_token       String?
  expires_at         Int?
  token_type         String?
  scope              String?
  id_token           String?
  session_state      String?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime

  @@unique([identifier, token])
}

model Committee {
  id          String   @id @default(cuid())
  name        String   @unique
  description String?
  createdById String

  createdBy   User @relation("CommitteeCreator", fields: [createdById], references: [id])

  members     CommitteeMember[]
  meetings    Meeting[]

  createdAt   DateTime @default(now())
}

model CommitteeMember {
  id          String @id @default(cuid())

  committeeId String
  userId      String

  designation String?
  joinedAt    DateTime @default(now())

  committee   Committee @relation(fields: [committeeId], references: [id], onDelete: Cascade)
  user        User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([committeeId, userId])
}

model Meeting {
  id            String   @id @default(cuid())
  title         String
  description   String?
  scheduledAt   DateTime
  location      String?

  committeeId   String
  createdById   String

  committee     Committee @relation(fields: [committeeId], references: [id], onDelete: Cascade)
  createdBy     User @relation("MeetingCreator", fields: [createdById], references: [id])

  agendas       Agenda[]
  votes         Vote[]
  attendances   Attendance[]
  minutes       Minute?

  createdAt     DateTime @default(now())
}

model Agenda {
  id          String   @id @default(cuid())
  meetingId   String
  title       String
  description String?
  duration    Int      @default(15)
  meeting     Meeting  @relation(fields: [meetingId], references: [id], onDelete: Cascade)
  createdAt   DateTime @default(now())
}

model Attendance {
  id          String   @id @default(cuid())
  meetingId   String
  userId      String
  status      String   @default("ABSENT")
  meeting     Meeting  @relation(fields: [meetingId], references: [id], onDelete: Cascade)
  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@unique([meetingId, userId])
}

model Minute {
  id          String @id @default(cuid())

  meetingId   String @unique
  transcript  String
  summary     String?

  meeting      Meeting @relation(fields: [meetingId], references: [id], onDelete: Cascade)

  createdAt    DateTime @default(now())
}

model Vote {
  id          String @id @default(cuid())

  meetingId   String
  userId      String

  type        String
  comment     String?

  meeting     Meeting @relation(fields: [meetingId], references: [id], onDelete: Cascade)
  user        User @relation(fields: [userId], references: [id], onDelete: Cascade)

  createdAt   DateTime @default(now())

  @@unique([meetingId, userId])
}

model AuditLog {
  id          String   @id @default(cuid())

  userId      String?
  action      String
  entity      String
  entityId    String?

  metadata    String?

  createdAt   DateTime @default(now())
}
